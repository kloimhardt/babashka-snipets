#player
(current player *)
(* is #in #study)
(descr *) You are Professor Kurt. You changed the first name to Immanuel at the age of 22. %% You consider Immanuel to be closer to Hebrew origins.

#documents
(name *) documents
(* is #in #drawer)
(descr *) The passport says "Emanuelle Kurt, born 1760". I am 29 going on 30, you think. Still you are the youngest professor amongst all colleagues here, in the eastern empire and the northern states.
(instead of [take *])
  (try [wear #wig])

#study
(name *)		study
(room *)
(look *)		This is a very nondescript room, dominated by a wooden writing table.
(from * go #north to #kitchen)

#chair
(name *)		chair
(dict *)		white plain
(look *) haio
%% (colour *) white
%% (material *) plastic
(on-seat *)
(appearance *)		You notice a conspicuous chair here.
(* is #in #study)

%% (descr $O) The (name $O) is painted (colour $O) and made of (material $O)

#writingtable
(name *) Writing table
(supporter *)
(* is #in #study)
(descr *) The writing table has a drawer

#drawer
(name *) Drawer
(* is #in #study)
(openable *)
(container *)
(perform [open *])
  (try [open *])
  You open the drawer, seeing documents and a wig.
  (line)
	(now) (Reinhold scene is running)

(on every tick in #study)
	(Reinhold scene is running)
  (select)
	"Immanuel, you are needed at the tower!"
	shouts Reinhold at the top of his lungs.
  (or)
  "It is urgent", Reinhold shouts.
  (now) ~(Reinhold scene is running)
  (stopping)

#wig
(name *) Wig
(wearable *)
(descr *) It is the wig you brought from the northern fringe of the northern empire, your hometown of Kingsburg.
(* is #in #drawer)

#door
(door *)
(openable *)
(name *)		small door
(descr *)		It's a perfectly ordinary, but small, door.
(from #study go #south through * to #anteroom)

#obersaalsberg
(name *) Obersaalsberg
(descr *) menace
(#study attracts *)
(#kitchen attracts *)
(#housestreet attracts *)
(#unistreet attracts *)
(#canteenstreet attracts *)

#untersberg
(name *) Untersberg
(descr *) friendly
(#study attracts *)
(#kitchen attracts *)
(#housestreet attracts *)
(#unistreet attracts *)
(#canteenstreet attracts *)

#window
(name *) window
(descr *) From your window looking south and southwest, you can see snowcapped mountains. Atop you see the village of (name #obersaalsberg), but that hill is really only alive at (name #untersberg).
(#study attracts *)
(#kitchen attracts *)

#kitchen
(name *) kitchen
(room *)
(look *) A small recess with a shelf and a stove.
(from * go #south to #study)

#shelf
(name *) shelf
(supporter *)
(descr*) There are flowers, a salt-cellar and a plate.
(* is #in #kitchen)

#plate
(name *) plate
(item *)
(supporter *)
(* is #on #shelf)

#salt-cellar
(name *) salt-cellar
(dict *) salt cellar saliera
(item *)
(descr *) It is not as famous as Cellini's Saliera, the pride of the university's collection. But it is filled and works.
(* is #on #shelf)

#flowers
(name *) flowers
(descr *) The watered flowers bloom on the shelf.
(* is #on #shelf)

